# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next-dev-err.log
.next-dev-out.log
debug.log
/.runtime/

# env files (can opt-in for committing if needed)
.env*

# TSIDEK local RAG inbox: keep staged legal documents private by default
rag-sources/ready-made-documents/*
!rag-sources/ready-made-documents/.gitkeep
!rag-sources/ready-made-documents/README.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
